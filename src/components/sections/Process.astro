---
import Container from '../ui/Container.astro';
import type { LandingContent } from '../../types/landing';
type Props = { content: LandingContent['process']; id: string };
const { content, id } = Astro.props;
---

<section id={id} class="section"><Container><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2><ol class="steps">{content.steps.map((step) => <li>{step}</li>)}</ol></Container></section>
