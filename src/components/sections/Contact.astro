---
import Container from '../ui/Container.astro';
import type { LandingContent } from '../../types/landing';
type Props = { content: LandingContent['contact']; id: string };
const { content, id } = Astro.props;
---

<section id={id} class="section contact"><Container><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2><p class="lead">{content.description}</p><a class="button" href={`mailto:${content.email}`}>{content.actionLabel}</a></Container></section>
